# ─────────────────────────────────────────────────────────────────────────────
# Значения переменных для demo-stack.yml.
#
# КУДА ВСТАВЛЯТЬ: окно «Развернуть стек» → вкладка «Переменные» → поле .env.
# Формат: одна переменная на строку, KEY=value. Строки с # — комментарии.
#
# Эти значения подставятся вместо ${VAR} в YAML. Убери файл — и подставятся
# значения по умолчанию (после :- в ${VAR:-...}).
# ─────────────────────────────────────────────────────────────────────────────

# Сообщение сервиса api (увидишь в браузере на :19081)
API_MESSAGE=Hello from the .env file, Murad!

# «Окружение» и версия — попадут и в текст api, и в его Env-блок в панели
API_ENV=production
API_VERSION=2.0

# Пароль redis для сервиса worker (реально применяется + виден в Env панели)
REDIS_PASSWORD=S3cret_From_Env_File
